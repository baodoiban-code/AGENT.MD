from pptx import Presentation
from pptx.util import Inches, Pt

# Khởi tạo bản thuyết trình mới
prs = Presentation()

# Thêm Slide tiêu đề (Layout 0)
slide_layout = prs.slide_layouts[0]
slide = prs.slides.add_slide(slide_layout)

title = slide.shapes.title
subtitle = slide.placeholders[1]

title.text = "Slide Dự Án Tự Động Với Codex"
subtitle.text = "Người thực hiện: AI Assistant"

# Thêm Slide nội dung (Layout 1)
blank_slide_layout = prs.slide_layouts[1]
slide2 = prs.slides.add_slide(blank_slide_layout)

title2 = slide2.shapes.title
title2.text = "Nội Dung Chính Dự Án"
content2 = slide2.placeholders[1]
content2.text = "- Bước 1: Thu thập dữ liệu\n- Bước 2: Thiết kế bằng AI\n- Bước 3: Xuất video thành phẩm"

# Lưu file slide
prs.save("presentation.pptx")

