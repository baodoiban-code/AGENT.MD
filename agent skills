import os, socket, sys, threading, time, yaml

srv = socket.socket(); srv.bind(("127.0.0.1", 0)); srv.listen(8)
port = srv.getsockname()[1]
t0 = time.time()
def accept():
    while True:
        c, _ = srv.accept()
        print(f"[{time.time()-t0:6.1f}s] connection accepted", flush=True)  # never answer
threading.Thread(target=accept, daemon=True).start()

home = "/tmp/hermes-judge-repro"; os.makedirs(home, exist_ok=True)
yaml.safe_dump({"auxiliary": {"goal_judge": {
    "provider": "openai", "model": "any-model",
    "base_url": f"http://127.0.0.1:{port}/v1", "api_key": "dummy"}}},
    open(f"{home}/config.yaml", "w"))
os.environ["HERMES_HOME"] = home

